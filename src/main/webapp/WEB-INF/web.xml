<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <session-config><session-timeout>15</session-timeout><cookie-config><http-only>true</http-only></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
  <security-constraint><web-resource-collection><web-resource-name>Aplicacion privada</web-resource-name><url-pattern>/api/*</url-pattern><url-pattern>/dashboard</url-pattern><url-pattern>/favoritos</url-pattern></web-resource-collection><auth-constraint><role-name>USUARIO</role-name></auth-constraint></security-constraint>
  <!-- Errores del contenedor (seguridad, rutas inexistentes) con Problem Details en /api: ErrorHttpServlet. -->
  <error-page><error-code>401</error-code><location>/error-http</location></error-page>
  <error-page><error-code>403</error-code><location>/error-http</location></error-page>
  <error-page><error-code>404</error-code><location>/error-http</location></error-page>
  <error-page><error-code>405</error-code><location>/error-http</location></error-page>
  <error-page><error-code>500</error-code><location>/error-http</location></error-page>
  <security-role><role-name>USUARIO</role-name></security-role>
</web-app>
