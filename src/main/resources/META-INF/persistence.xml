<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="inversorarPU" transaction-type="JTA">
        <jta-data-source>${db.datasource}</jta-data-source>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="${db.schema.action}"/>
        </properties>
    </persistence-unit>
</persistence>
